# Copy to .env and configure a Subscan API key before loading governance data.
# API keys stay on the Next.js server. See README.md for setup.
# Sources: "subscan" (default in every environment), "pubfi", or "cluster".
SUBSCAN_API_SOURCE=subscan
SUBSCAN_API_KEY=

# Legacy network-prefixed PubFi gateway. Verify provider compatibility before use.
# Set SUBSCAN_API_SOURCE=pubfi to opt in.
PUBFI_API_KEY=

# Optional private upstreams; required only for SUBSCAN_API_SOURCE=cluster.
# JSON object mapping every key below to a complete http(s) base URL:
# polkadot, kusama, assethub-polkadot, assethub-kusama, assethub-paseo, statemint,
# collectives-polkadot, coretime-polkadot, coretime-kusama, people-polkadot, people-kusama.
# Use your own addresses, for example http://polkadot.internal.test:8080.
SUBSCAN_CLUSTER_BASE_URLS=

# Optional additional dev hostnames, comma-separated. Localhost needs no entry.
SUBGOV_DEV_ORIGINS=

# Optional WalletConnect project ID. Browser extension wallets do not need it.
# NEXT_PUBLIC_* values are public and are embedded at build time.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional DeGov comments. Register your own space and allowed browser origins.
# The upstream "subgov" space does not grant a fork permission to authenticate.
NEXT_PUBLIC_DEGOV_DISCUSSION_API=https://api.degov.ai/graphql
NEXT_PUBLIC_DEGOV_DISCUSSION_SPACE=your-space
DEGOV_DISCUSSION_API=https://api.degov.ai/graphql
# Server-only credential, needed only to provision missing discussion targets.
DEGOV_DISCUSSION_ADMIN_TOKEN=
# Allow http://localhost:3000 for pnpm dev, http://localhost:3015 for Compose,
# and your deployment origin in your DeGov space's configuration.
